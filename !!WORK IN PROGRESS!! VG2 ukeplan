  for (let i = 0; i < week.days; i++) {

    const date = addDays(week.startDate, i);
    const d = new Date(date);
    const isWeekend = d.getDay() === 0 || d.getDay() === 6;

    html += `
      <tr class="${isWeekend ? 'weekend-row' : ''}">
        <td class="date-cell" data-date="${date}" width="10.6%">
