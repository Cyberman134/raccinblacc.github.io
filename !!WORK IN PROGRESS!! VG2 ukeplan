  const weekEnd = new Date(week.startDate);
  weekEnd.setHours(0, 0, 0, 0);
  weekEnd.setDate(weekEnd.getDate() + week.days - 1);

  const isPastWeek = today > weekEnd;
  const isCurrentWeek = today >= weekStart && today <= weekEnd;
  const isFutureWeek = today < weekStart;

  html += `
  <div class="${
  isCurrentWeek ? 'active-week'
  : isPastWeek ? 'past-week'
  : 'inactive-week'
  }"
