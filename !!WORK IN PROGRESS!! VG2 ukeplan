let clickCount = 0;
// Update nav button styles based on active page
function updateNavActive(pageId) {
  const ids = ['page1','page2','page3','page4', 'Hemmelig'];
  ids.forEach(id => {
    const btn = document.getElementById(id + 'Button');
    if (!btn) return;
    if (pageId === id) {
      btn.classList.remove('pagenavin');
      btn.classList.add('pagenava');
    } else {
      btn.classList.remove('pagenava');
      btn.classList.add('pagenavin');
    }
  });
}

//Pages
function showPage(pageId) {

    // Hide all pages
    document.querySelectorAll('.page').forEach(p =>
        p.classList.remove('active')
    );
    clickCount = 0;
    window.scrollTo({ top: 0, behavior: "smooth" });
    // Show da pages
    document.getElementById(pageId).classList.add('active');
   // ensure nav reflects the initial active page
  // get the navbar gap
  (function syncNavOffsets(){
    function updateNavOffset(){
      const nav = document.querySelector('.spcity');
      const navHeight = nav ? nav.offsetHeight : 0;
      document.documentElement.style.setProperty('--spcity-height', navHeight + 'px');
      document.documentElement.style.setProperty('scroll-padding-top', navHeight + 'px');
      document.body.style.paddingTop = navHeight + 10 +'px';
    }
    updateNavOffset();
    window.addEventListener('resize', updateNavOffset);
  })();
  function mainHeader(){
    const Phead = document.getElementById('Phead');
    if (!Phead) return;
    if (pageId === 'page1') {
      Phead.textContent = "Ukeplan 2STF 2026-2027";
    } else if (pageId === 'page2') {
      Phead.textContent = "Ekstra info";
    } else if (pageId === 'page3') {
      Phead.textContent = "Timeplan 2STF 2026-2027";
    } else if (pageId === 'page4') {
      Phead.textContent = "Oppdateringer";
    } else if (pageId === 'Hemmelig') {
      Phead.textContent = "Arbeidsområdet";
    } else {
      Phead.textContent = "2STF 2026-2027";
    }
  }
  // Update nav button colours
  mainHeader();

    // Stopper Tetris hvis man forlater Hemmelig-siden
    if (pageId !== "Hemmelig") {
        TETRIS.stop();
        tetrisStarted = false;
        document.getElementById("HemmeligButton").style.display = "none";
    } else {
        document.getElementById("HemmeligButton").style.display = "inline-block";
    }
    if (pageId === "Hemmelig" && document.getElementById("tetris").classList.contains("active")) {
    TETRIS.init();
    }
  updateNavActive(pageId);
}
document.addEventListener("visibilitychange", () => {
  if (document.hidden) {
    TETRIS.stop();
    tetrisStarted = false;
  }
});

//stopper tetris om ute av webside
function showSubpage(subpageId) {

    document.querySelectorAll('.subpage').forEach(p =>
        p.classList.remove('active')
    );

    document.getElementById(subpageId).classList.add('active');
    if (subpageId !== "tetris") {
        TETRIS.stop();
        tetrisStarted = false;
    }
}

//'Nåværende' knapp
	function passive(x) {
	  x.style.backgroundColor = "var(--lightup-secondary)";
	}

	function lightup(x) {
	  x.style.backgroundColor = "var(--lightup-primary)";
	}

	function scrollToSection(e, el) {
   e.preventDefault();
   const id = el.getAttribute("href").substring(1);
   const target = document.getElementById(id);
   const nav = document.querySelector('.spcity');
   const navHeight = nav ? nav.offsetHeight : 0;
   if (target) {
     const top = target.getBoundingClientRect().top + window.scrollY - navHeight - 8; // small gap
     window.scrollTo({ top, behavior: 'smooth' });
   }
}

//Topp-knapp
document.addEventListener("DOMContentLoaded", function () {
  // ensure nav reflects the initial active page
  updateNavActive('page1');
  // Keep scroll offsets in sync with the actual sticky nav height
  (function syncNavOffsets(){
    function updateNavOffset(){
      const nav = document.querySelector('.spcity');
      const navHeight = nav ? nav.offsetHeight : 0;
      document.documentElement.style.setProperty('--spcity-height', navHeight + 'px');
      document.documentElement.style.setProperty('scroll-padding-top', navHeight + 'px');
      document.body.style.paddingTop = navHeight + 10 + 'px';
    }
    updateNavOffset();
    window.addEventListener('resize', updateNavOffset);
  })();
	  const mybutton = document.getElementById("myBtn");

	  window.addEventListener("scroll", function () {
	    if (window.scrollY > 20) {
	  mybutton.classList.add("show");
	} else {
	  mybutton.classList.remove("show");
	}
	  });
	
	  mybutton.addEventListener("click", function () {
	    window.scrollTo({ top: 0, behavior: "smooth" });
	  });
	


//Hemmelig

  const title = document.getElementById("Phead");
  const button = document.getElementById("HemmeligButton");
  

  title.addEventListener("click", () => {
    clickCount++;
    const activePageId = document.querySelector('.page.active')?.id;
    
    if (activePageId === 'Hemmelig' || clickCount >= 3 && clickCount % 2 !== 0){
      button.style.display = "inline-block";
    }
    else {
      button.style.display = "none";
    }
  });
});
/* =========================================================
   2. JS STOP
========================================================= */
</script>
