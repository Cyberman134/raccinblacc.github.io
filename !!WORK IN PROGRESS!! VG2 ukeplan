    height: 60vh;
    padding: 2rem 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: flex-start;
    position: sticky;
    z-index: inherit;
    left: 4px;
    top: calc(var(--spcity-height, 0px) + 10px);
