  }

  #Phead {
    cursor: pointer; 
    user-select: none;
    text-shadow:
    5px 5px 20px var(--header-background); 
  }

  /* Darkmode */

  #theme-switch {
    height: 50px;
    width: 50px;
    padding: 2px var(--background);
    border-radius: 50%;
    position: fixed;
    display: flex;
    top: 20px;
    right: 20px;
    align-items: center;
    justify-content: center;
    border: 3px solid var(--text-colour);
    transition: border-color 0.3s ease, transform 0.5s ease;;
    overflow: hidden;
    cursor: pointer; 
  }

  #theme-switch::before {
    content: "";
    position: absolute;
    inset: -2px;
    border-radius: 50%;
    background: linear-gradient(45deg, var(--background) 50%, var(--base-comp) 50%);
    transform: rotate(0deg);
    transition: transform 0.5s ease;
    z-index: -1;
    
  }

  /* DARK MODE ROTATION */
  .darkmode #theme-switch::before {
    transform: rotate(180deg);
  }

  #theme-switch:hover {
    transform: scale(1.05);
  }

  #theme-switch svg {
    position: absolute;
    top: 50%;
    left: 50%;
    fill: var(--secondary-outline);
    transition: opacity 0.25s ease, transform 0.25s ease;
    transform: translate(-50%, -50%);
  }

  #theme-switch svg:last-child {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.8);
  }

  .darkmode #theme-switch svg:first-child {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.8);
  }

  .darkmode #theme-switch svg:last-child {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }

  /* Nav bar */

  nav ul {
    list-style-type: none;
    display: flex;
    justify-content: space-around;
    margin: 0;
    padding: 0;
  }

  nav li {
    cursor: pointer;
    user-select: none;
    padding: 10px 20px;
    border-radius: 5px;
    background-color: var(--base-comp);
    font-family: 'Century Gothic';
    transition: background-color 0.3s ease, transform 0.3s ease, width 0.3s ease;
    border: 2px var(--base-comp) solid;
    font-size: 2vh;
    width: 10em;  
    text-align: center;
  }

 nav li:hover {
    background-color: var(--lightup-primary);
    border-radius: 5px;
    transition: background-color 0.3s ease, transform 0.3s ease, width 0.3s ease;
