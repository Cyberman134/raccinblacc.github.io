import pyautogui as pag
from pynput import keyboard


def on_press(key):
    print("Key pressed:", key,
          "vk=", getattr(key, "vk", None),
          "char=", getattr(key, "char", None))
    try:
        if getattr(key, 'vk') and key.vk == 97:
            print("\nReinforce registered")
            pag.press('up')
            pag.press('down')
            pag.press('right')
            pag.press('left')
            pag.press('up')
        elif getattr(key, 'vk') and key.vk == 98:
            print("\nRailgun registered")
            pag.press('down')
            pag.press('right')
            pag.press('down')
            pag.press('up')
            pag.press('left')
            pag.press('right')
    except AttributeError:
        pass



with keyboard.Listener(on_press=on_press) as listener:
    listener.join()
